#: src/routes/+page.svelte
msgid "Toutes les plateformes"
msgstr "Bimasini nyonso"

#: src/routes/+page.svelte
msgid "Votre musique YouTube, native, hors-ligne et sans pub."
msgstr "Miziki na yo ya YouTube, ya pɛto, kozanga internet mpe kozanga bapiblisite."

#: src/routes/+page.svelte
msgid "Vibratunes se connecte directement à l'API interne de YouTube et lit l'audio via libmpv et Media3. Zéro Electron, zéro publicité, avec téléchargements hors-ligne, karaoké IA et tunnel WARP intégré."
msgstr "Vibratunes ekangamaka mbala moko na API ya YouTube mpe ebetaka miziki na libmpv mpe Media3. Electron ezali te, bapiblisite ezali te, ezali na kobomba nzembo kozanga internet, karaoké ya IA mpe nzela ya WARP."

#: src/routes/+page.svelte
msgid "Open-source GPL-3.0 • Linux, Windows, macOS Apple Silicon & Android 8.0+"
msgstr "Open-source GPL-3.0 • Linux, Windows, macOS Apple Silicon mpe Android 8.0+"

#: src/routes/+page.svelte
msgid "Interface Desktop"
msgstr "Emoniseli ya Ordinatɛrɛ"

#: src/routes/+page.svelte
msgid "Paroles & Karaoké"
msgstr "Maloba mpe Karaoké"

#: src/routes/+page.svelte
msgid "Mode Vidéo"
msgstr "Lolenge ya Video"

#: src/routes/+page.svelte
msgid "Application Android"
msgstr "Esaleli ya Android"

#: src/routes/+page.svelte
msgid "Vue playlist dans Vibratunes Desktop"
msgstr "Emoniseli ya liste ya nzembo na Vibratunes Desktop"

#: src/routes/+page.svelte
msgid "Paroles synchronisées mot-à-mot dans Vibratunes"
msgstr "Maloba ya nzembo ekokani na mongongo na Vibratunes"

#: src/routes/+page.svelte
msgid "Lecture de clip vidéo à côté des paroles"
msgstr "Kobeta video pembeni ya maloba ya nzembo"

#: src/routes/+page.svelte
msgid "Accueil Vibratunes Android"
msgstr "Ebandeli ya Vibratunes Android"

#: src/routes/+page.svelte
msgid "Lecteur Vibratunes Android"
msgstr "Ebɛtɛli ya Vibratunes Android"

#: src/routes/+page.svelte
msgid "Paroles synchronisées sur Android"
msgstr "Maloba ya nzembo na Android"

#: src/routes/+page.svelte
msgid "Architecture & Fonctions"
msgstr "Ndenge esalaka & Makambo"

#: src/routes/+page.svelte
msgid "Conçu pour l'écoute, pas pour alourdir votre machine."
msgstr "Esalami mpo na koyoka miziki, te mpo na kokomisa masini kilo."

#: src/routes/+page.svelte
msgid "Chaque composant privilégie la réactivité, la fidélité audio et le contrôle local de votre bibliothèque."
msgstr "Eteni nyonso etyaka mbangu, mongongo ya kitoko mpe bokonzi ya nzembo na yo liboso."

#: src/routes/+page.svelte
msgid "Téléchargements hors-ligne"
msgstr "Kobomba nzembo kozanga internet"

#: src/routes/+page.svelte
msgid "Enregistrez vos titres, albums et playlists avec leurs pochettes haute résolution et métadonnées complètes pour écouter sans connexion."
msgstr "Bomba nzembo, ba-alubume mpe baliste na yo elongo na bililingi ya kitoko mpo na koyoka ata internet ezali te."

#: src/routes/+page.svelte
msgid "Paroles & Karaoké IA local"
msgstr "Maloba & Karaoké ya IA na masini"

#: src/routes/+page.svelte
msgid "Paroles synchronisées mot-à-mot multi-sources et séparation vocale en temps réel sur votre GPU (Vulkan, DirectML, CoreML) sans aucun serveur externe."
msgstr "Maloba ya nzembo liloba na liloba mpe kokabola mongongo na GPU na yo (Vulkan, DirectML, CoreML) kozanga kosalela serveur ya libanda."

#: src/routes/+page.svelte
msgid "Tunnel WARP intégré"
msgstr "Nzela ya WARP na kati"

#: src/routes/+page.svelte
msgid "Activez un tunnel WireGuard Cloudflare directement depuis les paramètres pour contourner le bridage réseau ou les restrictions géographiques."
msgstr "Fungola nzela ya WireGuard Cloudflare mbala moko na ba-paramètres mpo na koleka bipekiseli ya rezo."

#: src/routes/+page.svelte
msgid "Listen Together & Play Anywhere"
msgstr "Koyoka Elongo & Kobeta Epai Nyonso"

#: src/routes/+page.svelte
msgid "Écoutez en synchronisation avec vos amis ou liez votre téléphone Android à votre ordinateur pour contrôler la lecture à distance."
msgstr "Yoka nzembo elongo na baninga to kangisa telefone na yo ya Android na ordinatɛrɛ mpo na koyangela miziki mosika."

#: src/routes/+page.svelte
msgid "Moteur natif Rust & Kotlin"
msgstr "Motɛrɛ ya Rust mpe Kotlin"

#: src/routes/+page.svelte
msgid "Tauri 2 + libmpv sur Desktop, Kotlin + Media3 sur Android. Transitions gapless, normalisation sonore, pitch, vitesse et égaliseur 10 bandes."
msgstr "Tauri 2 + libmpv na Ordinatɛrɛ, Kotlin + Media3 na Android. Koleka nzembo kozanga kokatana, kobongisa mongongo mpe égaliseur ya banzela 10."

#: src/routes/+page.svelte
msgid "Thèmes adaptatifs & Scrobbling"
msgstr "Balangi ya nzembo & Scrobbling"

#: src/routes/+page.svelte
msgid "Couleurs extraites de la pochette en cours, support Matugen / pywal / wallust sous Linux, Discord Rich Presence, Last.fm et ListenBrainz."
msgstr "Balangi ezwami na elilingi ya nzembo, Matugen / pywal / wallust na Linux, Discord Rich Presence, Last.fm mpe ListenBrainz."

#: src/routes/+page.svelte
msgid "Téléchargements"
msgstr "Kokita esaleli"

#: src/routes/+page.svelte
msgid "Choisissez votre plateforme"
msgstr "Pona masini na yo"

#: src/routes/+page.svelte
msgid "Binaires signés et mises à jour automatiques intégrées sur Desktop et Android."
msgstr "Baprogramɛ oyo ekoki kotyelama motema mpe kobongisa yango moko na Ordinatɛrɛ mpe Android."

