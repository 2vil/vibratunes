{
  "name": "vibratunes",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir ui dev",
    "build": "pnpm --dir ui build",
    "dev:tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo tauri dev",
    "dev:tauri-android": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo tauri android dev",
    "build:tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo tauri build",
    "build:tauri-android": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo tauri android build",
    "build:install": "bash scripts/dist-install.sh --no-run",
    "build:install:run": "bash scripts/dist-install.sh",
    "build:install:android": "bash scripts/dist-install.sh android"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.81.0",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^3.3.1"
  }
}
